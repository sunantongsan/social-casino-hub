# Copy to .env at repository root. DEV_AUTH is local development only.
DEV_AUTH=true
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,https://localhost
# Production requires these. Never put DATABASE_URL in frontend or VITE_*.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Database TLS verifies certificates by default; optionally add Supabase CA PEM.
DATABASE_CA=
